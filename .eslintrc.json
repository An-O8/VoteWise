{
  "env": { "node": true, "es2022": true },
  "parserOptions": { "ecmaVersion": 2022 },
  "rules": {
    "no-unused-vars": "error",
    "no-console": ["warn", { "allow": ["error", "log"] }],
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "curly": "error",
    "no-throw-literal": "error",
    "consistent-return": "error"
  }
}